# --- Service ---
PORT=4040
# Public base URL — the secure links in SMS/email point here (https://<service>.onrender.com on Render).
PUBLIC_URL=http://localhost:4040
# Worker-console password. Empty = open console (local demo only).
ADMIN_PASSWORD=
AGENCY_NAME=Healthy Together
STATE_CODE=TN

# --- Storage (Render injects DATABASE_URL; unset → in-memory store for local dev) ---
# DATABASE_URL=postgres://user:pass@host:5432/db

# --- AI first-pass document review (OpenAI vision). Unset → uploads are stored unanalyzed. ---
OPENAI_API_KEY=
OPENAI_OCR_MODEL=gpt-4o
OPENAI_MATCH_MODEL=gpt-4o-mini

# --- SMS (household links) — Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Email (provider links) — 'resend' needs RESEND_API_KEY + EMAIL_FROM; 'console' logs only and the console shows the link ---
EMAIL_VENDOR=console
EMAIL_FROM=
RESEND_API_KEY=

# --- CLEAR identity — 'sandbox' (with creds) or unset → labelled simulation ---
CLEAR_MODE=
CLEAR_API_KEY=
CLEAR_PROJECT_ID=
# DEMO ONLY: CLEAR's sandbox returns its own test identity; present the requested name instead. Never in a real deployment.
CLEAR_DEMO_NAME_MATCH=false

# --- Argyle payroll/bank — sandbox creds, or unset → labelled simulation ---
ARGYLE_API_BASE=https://api-sandbox.argyle.com/v2
ARGYLE_API_KEY_ID=
ARGYLE_API_KEY_SECRET=

# --- Demo ---
ENABLE_DEMO_SEED=true
FLOW_TOKEN_TTL_DAYS=14
